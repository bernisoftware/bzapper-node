{
  // Testes em TS compilados para dist-test/ e rodados com `node --test`.
  // Eles importam "@bzapper/client" (auto-referência pelo "exports"), ou seja, rodam contra o
  // artefato CONSTRUÍDO em dist/ — rode `npm run build` antes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./test",
    "outDir": "./dist-test",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["test/**/*.ts"]
}
